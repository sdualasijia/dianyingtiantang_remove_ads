[Script]
http-response ^https:\/\/api\.xhsdns\.cn\/api\/app\/init(?:\?.*)?$ requires-body=1,script-path=https://raw.githubusercontent.com/sdualasijia/dianyingtiantang_remove_ads/main/remove_xhsdns_ads.js,timeout=10,tag=电影天堂去广告

[MITM]
hostname = api.xhsdns.cn
